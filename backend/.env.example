# ==========================================
# ArthSetu / Vyapar Crash Test - Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="ArthSetu / Vyapar Crash Test API"
VERSION="0.2.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=arthsetu_user
POSTGRES_PASSWORD=arthsetu_password
POSTGRES_DB=arthsetu_db
DATABASE_URL=postgresql://arthsetu_user:arthsetu_password@localhost:5432/arthsetu_db

# Security & CORS
SECRET_KEY=dev_secret_key_change_in_production_phase2
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19000","http://localhost:19006","exp://localhost:8081","*"]
